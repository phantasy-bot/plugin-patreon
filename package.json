{
  "name": "@phantasy/plugin-patreon",
  "version": "0.1.0-beta",
  "private": false,
  "description": "Patreon API v2 audience, entitlement, and reviewed free/paid post-planning integration for Phantasy creator companions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "phantasy.plugin.json"
  ],
  "sideEffects": false,
  "keywords": [
    "patreon",
    "creator",
    "members",
    "tiers",
    "publishing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phantasy-bot/plugin-patreon"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/phantasy-bot/plugin-patreon",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@phantasy/agent": "^0.1.0-beta"
  },
  "peerDependenciesMeta": {
    "@phantasy/agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "@phantasy/agent": "file:./stubs/phantasy-agent",
    "vitest": "^3.2.4"
  },
  "phantasy": {
    "displayName": "Patreon",
    "category": "creator-business",
    "tags": [
      "patreon",
      "creator",
      "members",
      "tiers",
      "publishing"
    ],
    "workspace": "business",
    "extensionKind": "integration",
    "permissions": [
      "internet"
    ],
    "pluginDependencies": [],
    "platforms": [
      "node"
    ],
    "productionReady": false,
    "adminSurface": {
      "tabId": "patreon",
      "label": "Patreon",
      "workspace": "business",
      "kind": "generic",
      "keywords": [
        "patreon",
        "creator",
        "members",
        "tiers",
        "publishing"
      ]
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "campaignId": {
          "type": "string"
        },
        "defaultAudience": {
          "type": "string",
          "enum": [
            "public",
            "members",
            "tiers"
          ],
          "default": "public"
        },
        "defaultTierId": {
          "type": "string"
        },
        "maxPages": {
          "type": "number",
          "default": 10
        }
      }
    },
    "runtime": {
      "networkHosts": [
        "www.patreon.com"
      ]
    },
    "security": {
      "secrets": [
        "PATREON_ACCESS_TOKEN"
      ],
      "neverLog": [
        "PATREON_ACCESS_TOKEN",
        "accessToken"
      ],
      "securityWarning": "Patreon member data is sensitive. Keep tokens in the runtime secret manager and request only the scopes required by the selected tools."
    },
    "phantasy": {
      "extensions": [
        {
          "path": "./dist/index.js",
          "kind": "tool"
        }
      ],
      "pluginDependencies": [],
      "security": {
        "secrets": [
          "PATREON_ACCESS_TOKEN"
        ],
        "neverLog": [
          "PATREON_ACCESS_TOKEN",
          "accessToken"
        ],
        "securityWarning": "Patreon member data is sensitive. Keep tokens in the runtime secret manager and request only the scopes required by the selected tools."
      }
    }
  }
}
